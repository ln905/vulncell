DATABASE_URL="postgresql://vulncell:vulncell@localhost:5432/vulncell?connection_limit=25&pool_timeout=20"
# connection_limit: số connection Prisma giữ trong pool (mặc định ~25 tùy CPU) — chỉnh khi chạy load test
JWT_SECRET="doi-chuoi-nay-thanh-mot-chuoi-dai-ngau-nhien"
PORT=4000
FRONTEND_URL="http://localhost:5173"
REDIS_URL="redis://localhost:6379"
# Bật true khi chạy load test (k6/JMeter) để rate limit không chặn chính công cụ đo
RATE_LIMIT_DISABLED=false
# Bật true để đo baseline không cache (dùng cho benchmark trước/sau)
CACHE_DISABLED=false
# Rate limit tổng quát theo IP cho toàn bộ /api (chống spam/DoS)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW=60
# Đặt true khi deploy có HTTPS
COOKIE_SECURE=false
# Tên cookie phiên (mặc định "token"). Đổi khi chạy nhiều stack trên cùng host
# (ví dụ demo dùng "vc_demo_token") để các stack không ghi đè cookie của nhau.
# COOKIE_NAME=token
